#------------------------------------------------------------------------------------------------
# 4. 3.30 league items: Threads replace Scarabs (they feed the Map Device, up to 8 per map)
#------------------------------------------------------------------------------------------------
Show # Threads
	BaseType == "Abyss Thread" "Bestiary Thread" "Betrayal Thread" "Blight Thread" "Breach Thread" "Expedition Thread" "Incursion Thread" "Legion Thread" "Ritual Thread" "Ultimatum Thread" "Frayed Thread"
	SetFontSize 42
	SetTextColor 0 0 0 255
	SetBorderColor 0 0 0 255
	SetBackgroundColor 0 220 255 230
	PlayAlertSound 2 300
	PlayEffect Cyan
	MinimapIcon 1 Cyan Hexagon
