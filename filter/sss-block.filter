# STATIC STRIKE SLAYER: KEY BASES FROM ACT 1 TO 4 VOIDSTONES (3.30)
# These rules come first in the filter, so they win over the NeverSink / Tytykiller rules below.
#
# Styles (one look per meaning, so you learn them fast):
#   PINK, big, sound 4, pink star + beam .... KEY BASE: pick it up (crafting base or a direct upgrade)
#   PINK frame on dark, pink diamond ........ KEY RARE: same bases as rares; pick up and identify (life, res, phys)
#   GOLD, sound 1, red star + beam .......... 5- and 6-links; 4-links while levelling (colours don't matter since 3.29)
#   CYAN, sound 2 ........................... movement-speed boots while levelling; 3.30 Threads
#
# Any base name in a "BaseType ==" line must exist in the game, or the whole filter fails to load.
# Every name below is either in NeverSink's 3.29 filter or in the official 3.30 patch notes.

#------------------------------------------------------------------------------------------------
# 1. Links: any colour fits any socket, so links are all that matter
#------------------------------------------------------------------------------------------------
Show # 6-link, anywhere
	LinkedSockets 6
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 200 0 0 255
	PlayAlertSound 1 300
	PlayEffect Red
	MinimapIcon 0 Red Star

Show # 5-link: the Static Strike body armour (campaign and maps)
	LinkedSockets 5
	Class == "Body Armours" "Two Hand Axes" "Two Hand Swords" "Two Hand Maces"
	SetFontSize 45
	SetTextColor 0 0 0 255
	SetBorderColor 0 0 0 255
	SetBackgroundColor 255 200 0 255
	PlayAlertSound 1 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Star

Show # 4-link gear while levelling (Static Strike 4L in Acts 1-5, utility links later)
	LinkedSockets >= 4
	AreaLevel <= 60
	Class == "Body Armours" "Helmets" "Gloves" "Boots" "Two Hand Axes" "Two Hand Swords" "Two Hand Maces"
	Rarity Normal Magic Rare
	SetFontSize 45
	SetTextColor 0 0 0 255
	SetBorderColor 0 0 0 255
	SetBackgroundColor 255 200 0 230
	PlayAlertSound 1 300
	PlayEffect Yellow Temp
	MinimapIcon 1 Yellow Star

Show # 3-link 2H axe early (Spectral Throw / Static Strike 3L until a 4L shows up)
	LinkedSockets 3
	AreaLevel <= 22
	Class == "Two Hand Axes" "Two Hand Swords" "Two Hand Maces"
	SetFontSize 42
	SetTextColor 255 255 255 255
	SetBorderColor 255 200 0 255
	SetBackgroundColor 70 50 0 230
	MinimapIcon 2 Yellow Star

#------------------------------------------------------------------------------------------------
# 2. Campaign: movement speed and the level-61 crit swap (1H axe + tower shield)
#------------------------------------------------------------------------------------------------
Show # magic boots with movement speed (10-35%), campaign only
	Class == "Boots"
	Rarity Magic
	HasExplicitMod "Runner's" "Sprinter's" "Stallion's" "Gazelle's" "Cheetah's" "Hellion's"
	AreaLevel <= 67
	SetFontSize 45
	SetTextColor 0 0 0 255
	SetBorderColor 0 0 0 255
	SetBackgroundColor 0 220 255 255
	PlayAlertSound 2 300
	PlayEffect Cyan
	MinimapIcon 1 Cyan Circle

Show # KEY BASE: Reaver Axe is the crit-swap weapon base (level 61): take every one from Act 6 on
	BaseType == "Reaver Axe"
	AreaLevel >= 45
	AreaLevel <= 67
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 200 0 140 255
	PlayAlertSound 4 300
	PlayEffect Pink
	MinimapIcon 0 Pink Star

Show # KEY RARE: rare 1H axes for the crit swap (look for flat + % physical damage)
	Class == "One Hand Axes"
	Rarity Rare
	AreaLevel >= 45
	AreaLevel <= 67
	SetFontSize 42
	SetTextColor 255 230 245 255
	SetBorderColor 255 0 200 255
	SetBackgroundColor 60 0 45 240
	PlayEffect Pink Temp
	MinimapIcon 1 Pink Diamond

Show # KEY RARE: rare tower shields for the crit swap (life + resistances)
	Class == "Shields"
	BaseType "Tower Shield"
	Rarity Rare
	AreaLevel >= 40
	AreaLevel <= 67
	SetFontSize 42
	SetTextColor 255 230 245 255
	SetBorderColor 255 0 200 255
	SetBackgroundColor 60 0 45 240
	PlayEffect Pink Temp
	MinimapIcon 1 Pink Diamond

#------------------------------------------------------------------------------------------------
# 3. Maps: crafting bases for the voidstone gear (normal/magic = craft it, rare = identify it)
#------------------------------------------------------------------------------------------------
Show # KEY BASE (3.30): fractured copies of the build's bases. Tier 5 magic items can now drop fractured; the fractured mod survives every craft
	FracturedItem True
	Rarity Normal Magic Rare
	BaseType == "Reaver Axe" "Royal Plate" "Astral Plate" "Leviathan Gauntlets" "Precursor Gauntlets" "Spiked Gloves" "Giantslayer Helmet" "General's Helmet" "Eternal Burgonet" "Royal Burgonet" "Leviathan Greaves" "Brimstone Treads" "Two-Toned Boots" "Titan Greaves" "Colossal Tower Shield" "Pinnacle Tower Shield" "Ebony Tower Shield" "Stygian Vise" "Amethyst Ring" "Two-Stone Ring" "Vermillion Ring" "Heavy Belt"
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 200 0 140 255
	PlayAlertSound 4 300
	PlayEffect Pink
	MinimapIcon 0 Pink Star

Show # KEY BASE (3.30): Spiked Gloves (now 24-30% increased melee damage) and Two-Toned Boots (now +16-20% to two resistances) only drop as tiered magic/rare items, so take any item level
	BaseType == "Spiked Gloves" "Two-Toned Boots"
	Rarity Normal Magic
	AreaLevel >= 68
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 200 0 140 255
	PlayAlertSound 4 300
	PlayEffect Pink
	MinimapIcon 0 Pink Star

# 3.30 Item Tiers: tier 4-5 unidentified rares of the build's bases (same UnidentifiedItemTier syntax as NeverSink 8.21.0a).
Show # KEY RARE: tier 4-5 unidentified rares of the build's bases (better mods, links and quality)
	UnidentifiedItemTier >= 4
	Rarity Rare
	Identified False
	BaseType == "Reaver Axe" "Royal Plate" "Astral Plate" "Leviathan Gauntlets" "Spiked Gloves" "Giantslayer Helmet" "Two-Toned Boots" "Leviathan Greaves" "Pinnacle Tower Shield" "Stygian Vise" "Amethyst Ring" "Vermillion Ring"
	SetFontSize 45
	SetTextColor 255 230 245 255
	SetBorderColor 255 0 200 255
	SetBackgroundColor 100 0 75 255
	MinimapIcon 0 Pink Diamond

